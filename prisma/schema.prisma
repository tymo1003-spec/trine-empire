
datasource db {
  provider = "sqlite"
  url = "file:./dev_3002.db"
}

generator client {
  provider = "prisma-client-js"
}

model Block {
  id           Int      @id @default(autoincrement())
  index        Int?
  timestamp    String
  data         String
  hash         String
  prevHash String
  nonce        Int?
  difficulty   Int?
  createdAt    DateTime @default(now())

  @@index([index])
  @@index([hash])
  @@index([prevHash])
}
