datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Block {
  timestamp BigInt
  id        Int      @id @default(autoincrement())
  index     Int
  data      String
  hash      String
  prevHash  String
  createdAt DateTime @default(now())

  @@index([index])
  @@index([hash])
  @@index([prevHash])
}
